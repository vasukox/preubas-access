# Variables de entorno para NestJS (TypeORM)
# ═══════════════════════════════════════════════════════════════════

# ── Aplicación ────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
APP_NAME=KOAJ Access API
APP_VERSION=2.0.0

# ── Base de datos (MySQL) ─────────────────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=vD8Ax09;
DATABASE_NAME=koaj2_access

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-key-NO-usar-en-produccion-32chars!!
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Archivos ──────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ── API Keys para hardware externo ────────────────────────────────
LPR_API_KEY=
NFC_READER_API_KEY=