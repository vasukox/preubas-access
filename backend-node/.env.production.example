# ═══════════════════════════════════════════════════════════════════
# KOAJ Access v2.0 — Permoda S.A.S.
# Template .env para PRODUCCIÓN — copiar a .env en el servidor
# ═══════════════════════════════════════════════════════════════════

# ── Aplicación ────────────────────────────────────────────────────
NODE_ENV=production
PORT=8000
APP_NAME=KOAJ Access API
APP_VERSION=2.0.0

# ── Base de datos (MySQL / MariaDB) ───────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=koaj_user          # NO usar root en producción
DATABASE_PASSWORD=<contraseña-segura>
DATABASE_NAME=koaj_access

# ── JWT ───────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-chars-hex-aleatorio>
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS — poner la URL exacta del frontend en producción ─────────
CORS_ORIGINS=https://tu-dominio.com

# ── Archivos ──────────────────────────────────────────────────────
UPLOAD_DIR=/var/koaj/uploads     # Ruta absoluta y persistente
MAX_UPLOAD_SIZE_MB=5

# ── API Keys hardware (opcionales hasta implementar) ─────────────
LPR_API_KEY=
NFC_READER_API_KEY=
