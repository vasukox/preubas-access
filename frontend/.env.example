# URL base del backend sin /api/v1 (el cliente lo agrega).
# En desarrollo local/túnel, dejar vacío para usar el mismo host del frontend
# y pasar por el proxy de Vite (/api y /ws).
VITE_API_URL=

# URL base de websocket sin path final /ws/{sede_id}.
# En desarrollo local/túnel, dejar vacío para usar host actual (wss://... en túnel).
VITE_WS_URL=
