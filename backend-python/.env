# ═══════════════════════════════════════════════════════════════
# KOAJ Access v2.0 — Permoda S.A.S.
# Variables de entorno — DESARROLLO
# ═══════════════════════════════════════════════════════════════

# ── Base de datos ─────────────────────────────────────────────
# MySQL 8.0 — Servidor local
DATABASE_URL=mysql+pymysql://root:vD8Ax09;@127.0.0.1:3306/koaj2_access

# ── JWT ───────────────────────────────────────────────────────
# Clave de firma para los tokens JWT
# En producción cambiar por una clave segura generada con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-NO-usar-en-produccion-32chars!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Servidor ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# ── Archivos ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ── API Keys hardware (configurar cuando llegue el hardware) ──
LPR_API_KEY=
NFC_READER_API_KEY=