APP_NAME=KOAJ Access API
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# Formato: mysql+pymysql://usuario:password@host:puerto/base
DATABASE_URL=mysql+pymysql://koaj_user:koaj_password@localhost:3306/koaj_access

# Cambiar en cualquier entorno compartido o productivo
SECRET_KEY=change-me-super-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:5173

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Requeridos en produccion
LPR_API_KEY=
NFC_READER_API_KEY=
